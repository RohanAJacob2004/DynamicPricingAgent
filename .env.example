# Environment Configuration
# Copy this file to .env and adjust values as needed

# Database
DB_PATH=pricing_poc.db

# API
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=INFO

# LLM (Optional - for future integration with LangChain)
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=gpt-4

# Feedback System Tuning
HUMAN_APPROVAL_DELTA=0.02
HUMAN_REJECTION_DELTA=-0.05
MARKET_SUCCESS_DELTA=0.03
MARKET_FAILURE_DELTA=-0.04
